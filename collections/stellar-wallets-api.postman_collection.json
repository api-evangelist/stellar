        {
          "id": "4316dbba-c7ab-4332-8bf1-f6dc8980e6f2",
          "name": "Get All Wallets",
          "request": {
            "name": "Get All Wallets",
            "description": {
              "content": "Fetches the list of available wallet providers to populate the dropdown box in the New Disbursement flow. The organization should coordinate with the wallet provider before selecting a particular wallet provider for a disbursement. By default, soft-deleted wallets are excluded from the response. Use the `include_deleted` parameter to include them.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wallets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include_deleted",
                  "value": "false",
                  "description": "When set to `true`, includes soft-deleted wallets in the response. When `false` or omitted, only non-deleted wallets are returned."
                },
                {
                  "disabled": false,
                  "key": "enabled",
                  "value": "<boolean>",
                  "description": "Filter wallets by enabled/disabled status."
                },
                {
                  "disabled": false,
                  "key": "user_managed",
                  "value": "<boolean>",
                  "description": "Filter by user-managed wallets."
                },
                {
                  "disabled": false,
                  "key": "supported_assets",
                  "value": "<string>",
                  "description": "Comma-separated list of asset codes or IDs to filter wallets by supported assets (max 20)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [
            {
