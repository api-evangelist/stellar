    {
      "id": "2418ac1d-9266-4721-9f84-34e0c1e995b1",
      "name": "Paths",
      "description": {
        "content": "Paths provide information about potential path payments. A path can be used to populate the necessary fields for a path payment operation.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6289c9cc-5d72-47cb-b16e-988cfaeb3773",
          "name": "List Strict Receive Payment Paths",
          "request": {
            "name": "List Strict Receive Payment Paths",
            "description": {
              "content": "The strict receive payment path endpoint lists the paths a payment can take based on the amount of an asset you want the recipient to receive. The destination asset amount stays constant, and the type and amount of an asset sent varies based on offers in the order books.\n\nFor this search, Horizon loads a list of assets available to the sender (based on `source_account` or `source_assets`) and displays the possible paths from the different source assets to the destination asset. Only paths that satisfy the `destination_amount` are returned.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "paths",
                "strict-receive"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "source_account",
                  "value": "<string>",
                  "description": "The Stellar address of the sender. Any returned path must start with an asset that the sender holds. Using either `source_account` or `source_assets` as an argument is required for strict receive path payments."
                },
                {
                  "disabled": false,
                  "key": "source_assets",
                  "value": "<string>",
                  "description": "A comma-separated list of assets available to the sender. Any returned path must start with an asset in this list. Each asset is formatted as `CODE:ISSUER_ACCOUNT`. For example: `USD:GDUKMGUGDZQK6YHYA5Z6AY2G4XDSZPSZ3SW5UN3ARVMO6QSRDWP5YLEX`. Using either `source_account` or `source_assets` as an argument is required for strict receive path payments."
                },
                {
                  "disabled": false,
                  "key": "destination_asset_type",
                  "value": "<string>",
                  "description": "(Required) The type for the destination asset. Either `native`, `credit_alphanum4`, or `credit_alphanum12`."
                },
                {
                  "disabled": false,
                  "key": "destination_asset_issuer",
                  "value": "<string>",
                  "description": "The Stellar address of the issuer of the destination asset. Required if the `destination_asset_type` is not `native`."
                },
                {
                  "disabled": false,
                  "key": "destination_asset_code",
                  "value": "<string>",
                  "description": "The code for the destination asset. Required if the `destination_asset_type` is not `native`."
                },
                {
                  "disabled": false,
                  "key": "destination_amount",
                  "value": "<string>",
                  "description": "(Required) The amount of the destination asset that should be received."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
