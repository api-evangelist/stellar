          "request": {
            "name": "List Strict Send Payment Paths",
            "description": {
              "content": "The strict send payment path endpoint lists the paths a payment can take based on the amount of an asset you want to send. The source asset amount stays constant, and the type and amount of an asset received varies based on offers in the order books.\n\nFor this search, Horizon loads a list of assets that the recipient can receive (based on `destination_account` or `destination_assets`) and displays the possible paths from the different source assets to the destination asset. Only paths that satisfy the `source_amount` are returned.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "paths",
                "strict-send"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "source_asset_type",
                  "value": "<string>",
                  "description": "(Required) The type for the source asset. Either `native`, `credit_alphanum4`, or `credit_alphanum12`."
                },
                {
                  "disabled": false,
                  "key": "source_asset_issuer",
                  "value": "<string>",
                  "description": "The Stellar address of the issuer of the source asset. Required if the `source_asset_type` is not `native`."
                },
                {
                  "disabled": false,
                  "key": "source_asset_code",
                  "value": "<string>",
