      "id": "b8ce9615-75bb-465f-9359-d8062d26e367",
      "name": "Authentication",
      "description": {
        "content": "Authentication controls the log in/log out process for all SDP users, as well as the token refresh process. Authentication uses a JWT approach signed with an ES256 private key.",
        "type": "text/plain"
      },
