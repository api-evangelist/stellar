      "name": "Operations",
      "description": {
        "content": "Operations are objects that represent a desired change to the ledger: payments, offers to exchange currency, changes made to account options, etc. Operations are submitted to the Stellar network grouped in a Transaction.",
        "type": "text/plain"
      },
